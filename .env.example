# Copy to .env (git-ignored) and fill in locally. Never commit real values.

# AWS: profile name and region only. Credentials stay in your local AWS config.
AWS_PROFILE=rag-mock
AWS_REGION=us-east-1

# Provider selection. Defaults are offline fakes.
EMBEDDER=fake
VECTOR_STORE=memory
GENERATOR=stub

# Textract: M2 always uses AnalyzeDocument with FeatureTypes=["LAYOUT"] (about 0.004 USD/page).
# PDFs go to s3://$S3_BUCKET/raw/, raw JSON is cached under textract-cache/<sha256>.json.
S3_BUCKET=
# Optional: local public PDF used by `pytest -m integration`
TEXTRACT_TEST_PDF=

# Pinecone (only needed when VECTOR_STORE=pinecone)
PINECONE_API_KEY=
PINECONE_INDEX=
