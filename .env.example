# Copy to .env (git-ignored) and fill in locally. Never commit real values.

# AWS: profile name and region only. Credentials stay in your local AWS config.
AWS_PROFILE=rag-mock
AWS_REGION=us-east-1

# Provider selection (src/providers/factory.py). Defaults are offline fakes.
# Used by the API (python -m src.api), scripts/ask.py and scripts/eval_answers.py. The M3
# scripts (index_documents, search, eval_retrieval) always use Pinecone and ignore these.
# EMBEDDER=fake|pinecone  VECTOR_STORE=memory|pinecone  RERANKER=none|pinecone
# GENERATOR=stub|bedrock  (bedrock is not verified: blocked by an account restriction)
# For the API demo set: EMBEDDER=pinecone VECTOR_STORE=pinecone RERANKER=pinecone
# GENERATOR=stub PINECONE_NAMESPACE=__default__ (plus the Pinecone keys below).
EMBEDDER=fake
VECTOR_STORE=memory
RERANKER=none
GENERATOR=stub
# Only for GENERATOR=bedrock. An inference profile ID from `aws bedrock list-inference-profiles`
# (not a bare model ID). No default in code.
BEDROCK_INFERENCE_PROFILE_ID=

# Textract: M2 always uses AnalyzeDocument with FeatureTypes=["LAYOUT"] (about 0.004 USD/page).
# PDFs go to s3://$S3_BUCKET/raw/, raw JSON is cached under textract-cache/<sha256>.json.
S3_BUCKET=
# Optional: local public PDF used by `pytest -m integration`
TEXTRACT_TEST_PDF=

# Pinecone (only needed when VECTOR_STORE=pinecone). PINECONE_INDEX has no default in code.
# The index is a plain dense index: 1024 dimensions, cosine, serverless aws us-east-1.
PINECONE_API_KEY=
PINECONE_INDEX=doc-rag-mock
# Namespace read by the API when VECTOR_STORE=pinecone. Required, no default in code.
# __default__ is the default namespace (the M3 data); the M6 pipeline writes to "pipeline".
PINECONE_NAMESPACE=__default__
# One index uses one embedder. Changing the model means re-indexing everything.
# Required when EMBEDDER=pinecone (no default in code). The index uses llama-text-embed-v2.
PINECONE_EMBED_MODEL=llama-text-embed-v2
# Required when reranking (RERANKER=pinecone, or --rerank in the scripts); no default in code.
# Free plan: 500 rerank requests per month. The API makes one per /ask.
PINECONE_RERANK_MODEL=bge-reranker-v2-m3
