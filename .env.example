# Copy to .env (git-ignored) and fill in locally. Never commit real values.

# AWS: profile name and region only. Credentials stay in your local AWS config.
AWS_PROFILE=rag-mock
AWS_REGION=us-east-1

# Provider selection. Defaults are offline fakes.
# Real options: EMBEDDER=pinecone, VECTOR_STORE=pinecone (env-based selection arrives in M4;
# in M3 the scripts under scripts/ use Pinecone directly).
EMBEDDER=fake
VECTOR_STORE=memory
GENERATOR=stub

# Textract: M2 always uses AnalyzeDocument with FeatureTypes=["LAYOUT"] (about 0.004 USD/page).
# PDFs go to s3://$S3_BUCKET/raw/, raw JSON is cached under textract-cache/<sha256>.json.
S3_BUCKET=
# Optional: local public PDF used by `pytest -m integration`
TEXTRACT_TEST_PDF=

# Pinecone (only needed when VECTOR_STORE=pinecone). PINECONE_INDEX has no default in code.
# The index is a plain dense index: 1024 dimensions, cosine, serverless aws us-east-1.
PINECONE_API_KEY=
PINECONE_INDEX=doc-rag-mock
# One index uses one embedder. Changing the model means re-indexing everything.
PINECONE_EMBED_MODEL=llama-text-embed-v2
# Optional reranking (scripts: --rerank). Free plan: 500 rerank requests per month.
PINECONE_RERANK_MODEL=bge-reranker-v2-m3
